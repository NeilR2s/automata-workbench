{
  "$schema": "https://webreel.dev/schema/v1.json",
  "outDir": "./videos",
  "baseUrl": "http://localhost:5173",
  "viewport": "desktop-hd",
  "defaultDelay": 100,
  "clickDwell": 120,
  "theme": {
    "cursor": { "size": 22 },
    "hud": {
      "background": "rgba(31, 34, 40, 0.9)",
      "color": "#f7f7f2",
      "fontSize": 24,
      "fontFamily": "DejaVu Sans Mono, monospace",
      "borderRadius": 0,
      "position": "top"
    }
  },
  "videos": {
    "automata-workbench-demo": {
      "url": "/",
      "waitFor": "#input-string",
      "output": "../.webreel/cinema/interaction-preview.mp4",
      "zoom": 1.3333333333333333,
      "fps": 60,
      "quality": 95,
      "thumbnail": { "enabled": false },
      "steps": [
        { "action": "pause", "ms": 2800, "label": "Overview workbench" },
        { "action": "click", "selector": "#input-string", "label": "Enter input" },
        { "action": "key", "key": "mod+a", "target": "#input-string", "label": "Edit input" },
        { "action": "type", "text": "aaabaa", "charDelay": 75, "label": "Type accepted input" },
        { "action": "pause", "ms": 650, "label": "Inspect input" },
        { "action": "click", "text": "Simulate", "label": "Run DFA simulation" },
        { "action": "wait", "text": "Pause", "within": "main > section > aside", "timeout": 5000 },
        { "action": "click", "text": "Pause", "within": "main > section > aside", "label": "Pause DFA playback" },
        { "action": "pause", "ms": 650, "label": "Inspect paused trace" },
        { "action": "click", "text": "Back", "within": "main > section > aside", "label": "Step backward" },
        { "action": "pause", "ms": 450 },
        { "action": "click", "text": "Next", "within": "main > section > aside", "label": "Step forward" },
        { "action": "pause", "ms": 450 },
        { "action": "click", "text": "Play", "within": "main > section > aside", "label": "Resume DFA playback" },
        { "action": "moveTo", "selector": "main > header", "label": "Clear DFA stage" },
        { "action": "wait", "selector": "aside [data-step-active=\"true\"]:not(:has(~ [data-step-active]))", "timeout": 15000, "label": "Watch complete DFA trace" },
        { "action": "pause", "ms": 1600, "label": "Inspect accepted DFA result" },
        { "action": "click", "selector": "button[role=\"tab\"][id$=\"-trigger-control\"]", "label": "Switch back to control" },
        { "action": "click", "selector": "aside [role=\"tabpanel\"] > div:has(> #input-string) + div + div > button:last-of-type", "label": "Choose rejection sample", "description": "Select the exact ababaa sample, not an accepted sample containing that substring." },
        { "action": "pause", "ms": 400 },
        { "action": "click", "text": "Simulate", "label": "Run rejected DFA" },
        { "action": "moveTo", "selector": "main > header", "label": "Clear rejection stage" },
        { "action": "wait", "selector": "aside [data-step-active=\"true\"]:not(:has(~ [data-step-active]))", "timeout": 15000, "label": "Watch rejected trace" },
        { "action": "pause", "ms": 1800, "label": "Inspect rejected result" },
        { "action": "click", "selector": "button[role=\"tab\"][id$=\"-trigger-control\"]" },
        { "action": "click", "text": "CFG", "within": "[aria-label=\"Simulation mode\"]", "label": "Switch to CFG mode" },
        { "action": "click", "text": "aaabaa", "within": "main > section > aside", "label": "Choose CFG input" },
        { "action": "moveTo", "selector": "main > header", "label": "Clear CFG stage" },
        { "action": "pause", "ms": 1200, "label": "Inspect CFG rules" },
        { "action": "click", "text": "Simulate", "label": "Run CFG derivation" },
        { "action": "moveTo", "selector": "main > header", "label": "Watch sentential form" },
        { "action": "wait", "selector": "aside [data-step-active=\"true\"]:not(:has(~ [data-step-active]))", "timeout": 15000, "label": "Watch complete grammar derivation" },
        { "action": "pause", "ms": 1700, "label": "Inspect derived input string" },
        { "action": "click", "selector": "button[role=\"tab\"][id$=\"-trigger-control\"]", "label": "Switch back to control" },
        { "action": "click", "text": "PDA", "within": "[aria-label=\"Simulation mode\"]", "label": "Switch to PDA mode" },
        { "action": "click", "text": "aaabaa", "within": "main > section > aside", "label": "Choose PDA input" },
        { "action": "moveTo", "selector": "main > header", "label": "Clear PDA stage" },
        { "action": "pause", "ms": 1100, "label": "Inspect PDA model" },
        { "action": "click", "text": "Simulate", "label": "Run PDA simulation" },
        { "action": "moveTo", "selector": "main > header", "label": "Watch stack growth" },
        { "action": "wait", "selector": "aside [data-step-active=\"true\"]:not(:has(~ [data-step-active]))", "timeout": 15000, "label": "Watch complete PDA stack execution" },
        { "action": "pause", "ms": 1800, "label": "Inspect accepted PDA result" },
        { "action": "click", "selector": "button[role=\"tab\"][id$=\"-trigger-control\"]", "label": "Switch back to control" },
        { "action": "click", "text": "DFA", "within": "[aria-label=\"Simulation mode\"]" },
        { "action": "click", "selector": "#preset-select", "label": "Open machine presets" },
        { "action": "click", "text": "STARS", "within": "[role=\"listbox\"]", "label": "Reveal STARS" },
        { "action": "moveTo", "selector": "main > header", "label": "Clear STARS stage" },
        { "action": "pause", "ms": 3200, "label": "Inspect STARS" },
        { "action": "click", "selector": "#preset-select" },
        { "action": "click", "text": "BETS", "within": "[role=\"listbox\"]" },
        { "action": "click", "text": "Reset", "label": "Reset simulation" },
        { "action": "pause", "ms": 1500, "label": "Complete demonstration" }
      ]
    }
  }
}
